import streamlit as st
st.title("🛡️ A GUARD: Smart Fire Detection")
t = st.sidebar.slider("Temperature", 10, 100, 25)
s = st.sidebar.slider("Smoke level", 0, 500, 20)
if t > 60 or s > 200:
    st.error("🚨 RED CODE: DANGER DETECTED!")
    st.button("📞 Call 112", type="primary")
else:
    st.success("✅ Status: Normal")
st.metric("Temp", f"{t}°C")
st.metric("Smoke", s)
